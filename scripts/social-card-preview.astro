---
import '@fontsource-variable/manrope';
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><style is:global>
*{box-sizing:border-box}html,body{margin:0;width:1200px;height:630px;overflow:hidden}body{font-family:'Manrope Variable',sans-serif;background:#181818;color:#f8f2ec}.card{position:relative;width:1200px;height:630px;padding:64px;overflow:hidden}.card:before{content:'';position:absolute;width:560px;height:560px;right:-100px;top:-220px;border-radius:50%;background:radial-gradient(circle,#6b3345,transparent 70%);filter:blur(28px)}.brand{font-weight:600;letter-spacing:-.05em;font-size:32px;color:#dfa8b7}.brand b{display:inline-grid;place-items:center;width:44px;height:44px;border:1px solid #805267;border-radius:12px;margin-right:12px}.title{position:relative;font-size:76px;line-height:1.02;letter-spacing:-.055em;font-weight:600;margin:82px 0 24px;max-width:850px}.title span{color:#dfa8b7}.caption{font-size:17px;letter-spacing:.13em;text-transform:uppercase;color:#c5b9b8}.bottom{position:absolute;bottom:54px;left:64px;right:64px;display:flex;justify-content:space-between;border-top:1px solid #51474a;padding-top:20px;color:#b7a8a8;font-size:14px}.orb{position:absolute;right:100px;bottom:94px;width:250px;height:250px;border:1px solid #a8798770;border-radius:50%}.orb:before,.orb:after{content:'';position:absolute;border-radius:50%;inset:22px;border:1px solid #d4a9ae35}.orb:after{inset:60px;border:0;background:#a86e7380;filter:blur(34px)}
</style></head><body><main class="card"><div class="brand"><b><svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true"><path d="M9 8h5v24H9V8Zm10 12L31 8h-7L12 20l12 12h7L19 20Z" fill="currentColor"/></svg></b>kitsoe<span>.</span></div><h1 class="title">Сайты, в которых<br/>всё на своём месте<span>.</span></h1><p class="caption">Разработка с вниманием к деталям</p><div class="orb" aria-hidden="true"></div><div class="bottom"><span>САЙТЫ И ПРИЛОЖЕНИЯ</span><span>ОТ ИДЕИ К РЕЗУЛЬТАТУ</span></div></main></body></html>

---
const faqs = [
  ['Сколько стоит разработка?', 'Стоимость зависит от объёма, функциональности и материалов. После бесплатного обсуждения я подготовлю оценку. Согласуем сумму до начала работы.'],
  ['Можно прийти только с идеей?', 'Да. Начнём с того, для кого нужен сайт и какую задачу он должен решать. Помогу определить структуру, функции и подходящий формат.'],
  ['Сколько времени займёт проект?', 'Сроки определим после обсуждения объёма и готовности материалов. Зафиксируем этапы до старта, чтобы у вас было понимание процесса.'],
  ['Как устроена оплата?', 'Размер предоплаты и дальнейший порядок оплаты согласуем перед началом проекта. Условия зависят от задачи и объёма работы.'],
  ['Включены ли правки?', 'Правки в рамках согласованного задания включены до завершения работы. Дополнительные функции или изменение объёма обсуждаем отдельно.'],
  ['На странице показаны клиентские проекты?', 'Здесь представлены авторские демонстрации интерфейсов. Они показывают подход к деталям и взаимодействию. Портфолио будет дополняться по мере появления выполненных проектов.'],
  ['Что я получу в конце?', 'Согласованный сайт или приложение, исходный код и инструкции по запуску. Размещение и дальнейшую поддержку можно обсудить отдельно.'],
];
---
<section id="faq" class="section wrap faq-layout" aria-labelledby="faq-title">
  <div class="faq-intro" data-reveal><p class="eyebrow">04 / Вопросы</p><h2 id="faq-title" class="heading-2">Несколько<br />важных деталей.</h2><p class="body-3 muted">Если вашего вопроса здесь нет, обсудим его лично.</p><a class="text-link body-6" href="#contact">Обсудить проект <span aria-hidden="true">↗</span></a></div>
  <div class="faq-list" data-reveal>{faqs.map(([question,answer]) => <details><summary>{question}</summary><p class="body-3">{answer}</p></details>)}</div>
</section>

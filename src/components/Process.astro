---
const steps = [
  ['01', 'Задача и смета', 'Обсуждаем вашу идею, аудиторию и задачи. Согласуем объём, стоимость, сроки и предоплату. Вы знаете, с чего начинаем и к чему идём.'],
  ['02', 'Дизайн и код', 'Продумываю структуру, собираю дизайн и разрабатываю интерфейс. Показываю результат по этапам, чтобы решения оставались понятными.'],
  ['03', 'Проверка и сдача', 'Проверяю сценарии и разные экраны, вношу согласованные правки. Передаю готовый проект, исходники и инструкции по запуску.'],
];
---
<section id="process" class="section wrap" aria-labelledby="process-title">
  <div class="section-heading" data-reveal><div><p class="eyebrow">03 / Подход</p><h2 id="process-title" class="heading-2">Как мы будем работать</h2></div><p class="body-3">Заранее согласуем объём и стоимость. Вы увидите результат каждого этапа.</p></div>
  <ol class="steps">{steps.map(([n,title,text]) => <li class="step" data-reveal><div class="step-index" aria-hidden="true">{n}</div><h3 class="heading-5">{title}</h3><p class="body-3">{text}</p></li>)}</ol>
  <div class="process-note" data-reveal><span aria-hidden="true">↳</span><p class="body-6">Правки в рамках согласованной задачи включены до завершения работы. Новые идеи и расширение проекта обсуждаем отдельно.</p></div>
</section>

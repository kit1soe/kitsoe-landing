---
import '@fontsource-variable/manrope';
import '@fontsource-variable/cormorant-garamond';
import cyrillicFont from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import latinFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-cyrillic-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean }
const { title = site.title, description = site.description, home = false, noindex = false } = Astro.props;
const configuredUrl = import.meta.env.PUBLIC_SITE_URL?.trim();
const validUrl = configuredUrl && /^https:\/\/[a-z0-9.-]+(?::\d+)?\/?$/i.test(configuredUrl) ? configuredUrl : undefined;
const canonical = validUrl ? new URL(Astro.url.pathname, validUrl).href : undefined;
const indexable = validUrl && import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={cyrillicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const theme = localStorage.getItem('kitsoe-theme');
        if (theme === 'light' || theme === 'dark') document.querySelector('meta[name="color-scheme"]').content = theme;
      } catch { /* Site data may be blocked; system theme remains available. */ }
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#f7f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a171b" media="(prefers-color-scheme: dark)" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="kitsoe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={validUrl ? new URL('/og-v2.jpg', validUrl).href : '/og-v2.jpg'} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="kitsoe — сайты, в которых всё на своём месте" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    {home && <div class="page-light" data-page-light aria-hidden="true">
      <span class="page-light-field"></span>
      <span class="page-light-field"></span>
      <span class="page-light-weave"></span>
      <span class="page-light-cursor"></span>
    </div>}
    <a href="#main" class="skip-link">Перейти к содержанию</a>
    <Header home={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
